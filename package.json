{
  "name": "sealedai",
  "version": "1.0.0",
  "description": "Confidential AI model customization marketplace on 0G",
  "scripts": {
    "test": "tsx --test \"packages/*/test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "web:build": "esbuild apps/web/src/main.ts --bundle --format=esm --platform=browser --target=es2022 --minify --sourcemap --outfile=apps/web/dist/app.js --external:fs --external:path --external:os --external:'node:*' --define:process.env.NODE_ENV='\"production\"' && cp apps/web/index.html apps/web/dist/index.html",
    "web:serve": "python3 -m http.server 5173 -d apps/web/dist",
    "faultline": "tsx packages/episode/src/cli.ts",
    "hedera:serve": "tsx packages/hedera/src/paid-ping-server.ts",
    "hedera:pay": "tsx packages/hedera/src/paid-ping-client.ts",
    "hedera:buy": "tsx packages/hedera/src/buy-stress-test.ts",
    "hedera:recover": "tsx packages/hedera/src/retry-activation.ts",
    "hedera:run": "tsx packages/hedera/src/run-paid-job.ts",
    "fweb:build": "esbuild apps/faultline-web/src/main.ts --bundle --format=esm --platform=browser --target=es2022 --minify --sourcemap --outfile=apps/faultline-web/dist/app.js --external:fs --external:path --external:os --external:'node:*' --define:process.env.NODE_ENV='\"production\"' && cp apps/faultline-web/index.html apps/faultline-web/dist/index.html",
    "fweb:serve": "python3 -m http.server 5174 -d apps/faultline-web/dist",
    "memory": "tsx packages/memory/src/cli.ts",
    "mweb:build": "esbuild apps/memory-web/src/main.ts --bundle --format=esm --platform=browser --target=es2022 --minify --sourcemap --outfile=apps/memory-web/dist/app.js --define:process.env.NODE_ENV='\"production\"' && cp apps/memory-web/index.html apps/memory-web/dist/index.html",
    "mweb:serve": "python3 -m http.server 5175 -d apps/memory-web/dist"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "private": true,
  "dependencies": {
    "@0gfoundation/0g-storage-ts-sdk": "1.2.13",
    "@arkiv-network/sdk": "1.0.1",
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@phala/dcap-qvl": "0.7.1",
    "canonicalize": "5.1.0",
    "dotenv": "18.0.9",
    "eciesjs": "0.5.0",
    "ethers": "6.13.1",
    "viem": "2.57.16"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
