# Copy to .env and fill in your own values. Never commit .env.
PRIVATE_KEY=            # seller wallet (0G Galileo testnet)
BUYER_PRIVATE_KEY=      # buyer wallet for examples/10 and 11
RPC_URL=https://evmrpc-testnet.0g.ai
STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai
ZG_ROUTER_URL=https://router-api.0g.ai/v1
ZG_API_KEY=             # 0G Private Computer key from pc.0g.ai (set it to private-only routing)
ARKIV_API_KEY=          # from hub.arkiv.network/access-keys
ARKIV_RPC_URL=https://rpc.rabdi.db-chain.testnet.arkiv.network
FAULTLINE_TENANT_KEY=<32-byte hex: openssl rand -hex 32>

# Hedera x402 testnet; keep account keys only in local .env.
HEDERA_NETWORK=hedera:testnet
HEDERA_FACILITATOR_URL=https://x402.org/facilitator
HEDERA_MERCHANT_ACCOUNT_ID=
HEDERA_PAYER_ACCOUNT_ID=
HEDERA_PAYER_PRIVATE_KEY=
HEDERA_PAYMENT_ASSET=0.0.0
HEDERA_PAYMENT_AMOUNT=100000
