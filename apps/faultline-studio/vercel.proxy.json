{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://sedrica-w.tail1b988f.ts.net/api/:path*" },
    { "source": "/media/:path*", "destination": "https://sedrica-w.tail1b988f.ts.net/media/:path*" }
  ],
  "headers": [ { "source": "/(.*)", "headers": [ { "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" } ] } ]
}
