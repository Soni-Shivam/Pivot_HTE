    "web:serve": "python3 -m http.server 5173 -d apps/web/dist"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": true,
  "dependencies": {
    "@0gfoundation/0g-storage-ts-sdk": "1.2.13",
    "@arkiv-network/sdk": "1.0.1",
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@phala/dcap-qvl": "0.7.1",
    "canonicalize": "5.1.0",
    "dotenv": "18.0.9",
    "eciesjs": "0.5.0",
    "ethers": "6.13.1",
    "viem": "2.57.16"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
